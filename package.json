{
  "name": "wagering-processor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && eslint . && bun test test/unit --pass-with-no-tests",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency --pass-with-no-tests",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "infra:queues": "bun run scripts/create-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1176.0",
    "@mikro-orm/core": "7.2.11",
    "@mikro-orm/decorators": "7.2.11",
    "@mikro-orm/migrations": "7.2.11",
    "@mikro-orm/postgresql": "7.2.11",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
