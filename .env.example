# Copie para .env e preencha (valores de dev local estão em docker-compose.yml).
DATABASE_URL=
AWS_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Filas (criadas por `bun run infra:queues`). Os nomes são obrigatórios; o resto é opcional e usa o padrão entre parênteses.
SQS_WAGER_QUEUE_NAME=
SQS_WAGER_DLQ_NAME=
# SQS_CONSUMER_CONCURRENCY=       (5)  mensagens em processamento ao mesmo tempo neste processo
# SQS_BATCH_SIZE=                 (10) máximo por ReceiveMessage; limite do SQS: 10
# SQS_WAIT_TIME_SECONDS=          (20) long polling; limite do SQS: 20
# SQS_VISIBILITY_TIMEOUT_SECONDS= (30) quanto uma mensagem recebida fica invisível
# SQS_RETRY_BASE_SECONDS=         (5)  backoff de falha transitória: base · 2^(recebimentos-1), com jitter
# SQS_RETRY_MAX_SECONDS=          (120) teto do backoff
# SHUTDOWN_TIMEOUT_MS=            (25000) quanto o SIGTERM espera as mensagens em andamento
# Eventos de integração (outbox). A fila padrão é criada por `bun run infra:queues`; o nome é obrigatório, o resto é opcional.
SQS_EVENTS_QUEUE_NAME=
# OUTBOX_POLL_INTERVAL_MS=        (1000) espera entre passadas do publisher quando o lote não veio cheio
# OUTBOX_BATCH_SIZE=              (50)   eventos reivindicados por passada
# OUTBOX_LEASE_MS=                (30000) quanto um evento reivindicado fica reservado ao publisher; é também o atraso máximo para outro publicar se este morrer
# Readiness (GET /health/ready): prazo de cada dependência (Postgres e SQS), verificadas em paralelo.
# HEALTH_CHECK_TIMEOUT_MS=       (2000) acima disso a dependência conta como fora do ar
